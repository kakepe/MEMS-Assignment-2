<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>e7833288-0f90-4ccb-aaa7-529290498ff2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Gateway/**/*.cs" />
    <Content Include="Gateway/**/*.cs" />
    <!-- Explicit patch override: 13.6.4's implicit Hosting reference has GHSA-f7vh-h5g3-7jrh. -->
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.5" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.6.5" />
    <PackageReference Include="Aspire.Hosting.Blazor" Version="13.6.4-preview.1.26523.11" />
    <ProjectReference Include="../MEMS.Admin/MEMS.Admin.csproj" />
    <ProjectReference Include="../MEMS.Api/MEMS.Api.csproj" />
    <ProjectReference Include="../MEMS.Public/MEMS.Public.csproj" />
  </ItemGroup>
</Project>
