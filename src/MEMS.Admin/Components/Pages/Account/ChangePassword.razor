@page "/admin/account/change-password"
@attribute [Authorize(Policy = "Administrator")]
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using MEMS.Data.Identity
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> Users
@inject SignInManager<ApplicationUser> SignIn
@inject ElectionAccess Access
@inject NavigationManager Navigation
<PageTitle>Change password · MEMS Admin</PageTitle>
<div class="account-panel panel"><h1>Change password</h1>
    <p class="text-secondary">Use at least 8 characters, including uppercase, lowercase, a number and a symbol.</p>
    <PageFeedback Error="@error" Success="@(Changed == true ? "Your password was changed successfully." : null)" />
    <EditForm Model="Input" OnValidSubmit="Submit" OnInvalidSubmit="ClearPasswords" FormName="admin-change-password" method="post">
        <DataAnnotationsValidator /><ValidationSummary class="text-danger" role="alert" />
        <div class="mb-3"><label for="current-password" class="form-label">Current password</label><InputText id="current-password" type="password" class="form-control" @bind-Value="@Input.CurrentPassword" autocomplete="current-password" /><ValidationMessage For="() => Input.CurrentPassword" /></div>
        <div class="mb-3"><label for="new-password" class="form-label">New password</label><InputText id="new-password" type="password" class="form-control" @bind-Value="@Input.NewPassword" autocomplete="new-password" /><ValidationMessage For="() => Input.NewPassword" /></div>
        <div class="mb-4"><label for="confirm-password" class="form-label">Confirm new password</label><InputText id="confirm-password" type="password" class="form-control" @bind-Value="@Input.ConfirmPassword" autocomplete="new-password" /><ValidationMessage For="() => Input.ConfirmPassword" /></div>
        <button class="btn btn-primary" type="submit">Change password</button><a class="btn btn-link" href="/admin">Cancel</a>
    </EditForm>
</div>
@code {
    [SupplyParameterFromForm] private PasswordInput Input { get; set; } = default!;
    [SupplyParameterFromQuery] public bool? Changed { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private string? error;
    protected override void OnInitialized() => Input ??= new();
    private void ClearPasswords() { Input.CurrentPassword = ""; Input.NewPassword = ""; Input.ConfirmPassword = ""; }
    private async Task Submit()
    {
        try
        {
            await Access.RequireAdminAsync(HttpContext.User);
            var user = await Users.GetUserAsync(HttpContext.User);
            if (user is null) { error = "Sign in again to continue."; return; }
            var result = await Users.ChangePasswordAsync(user, Input.CurrentPassword, Input.NewPassword);
            if (!result.Succeeded) { error = string.Join(" ", result.Errors.Select(x => x.Description)); return; }
            await SignIn.RefreshSignInAsync(user);
            Navigation.NavigateTo("/admin/account/change-password?changed=true", forceLoad: true);
        }
        catch (ApiFault fault) { error = fault.Message; }
        finally { ClearPasswords(); }
    }
    public sealed class PasswordInput
    {
        [Required, StringLength(1024)] public string CurrentPassword { get; set; } = "";
        [Required, StringLength(1024, MinimumLength = 8)] public string NewPassword { get; set; } = "";
        [Required, Compare(nameof(NewPassword), ErrorMessage = "The new passwords must match.")] public string ConfirmPassword { get; set; } = "";
    }
}
